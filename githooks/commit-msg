#!/bin/sh
# commit-msg hook: 检查提交信息标记
# - 所有提交必须有 [验收通过] 标记
# - 结构性变更提交还必须有 [方案已确认] 标记
# 如需跳过（不推荐），使用 git commit --no-verify

commit_msg_file="$1"

# 查找 Python
PYTHON=""
if command -v python >/dev/null 2>&1; then
    PYTHON="python"
elif [ -f "/e/Python/python.exe" ]; then
    PYTHON="/e/Python/python.exe"
fi

# merge commit 或 revert 跳过所有检查
commit_msg=$(sed '1s/^\xEF\xBB\xBF//' "$commit_msg_file" | tr -d '\r')
if echo "$commit_msg" | grep -qE '^Merge |^Revert '; then
    exit 0
fi

# 用 Python 做中文匹配，避免 shell grep 的编码问题
if [ -n "$PYTHON" ]; then
    result=$($PYTHON -c "
import sys, os, re

# 读取提交信息（UTF-8）
with open(sys.argv[1], 'r', encoding='utf-8', errors='replace') as f:
    msg = f.read().replace('\\r', '').replace('\\ufeff', '')

# 检查标记
has_acceptance = '[验收通过]' in msg
has_approval = '[方案已确认]' in msg
has_checked = '[已检查]' in msg

# 检查结构性变更
is_structural = False
try:
    sys.path.insert(0, '.trae/skills')
    from check_structural_change import get_changed_files, detect_structural_changes
    changed = get_changed_files(staged_only=True)
    is_s, _ = detect_structural_changes(changed)
    is_structural = bool(is_s)
except Exception:
    pass

# 输出结果
errors = []
if not has_acceptance:
    errors.append('acceptance_missing')
if is_structural and not has_approval:
    errors.append('approval_missing')
if not has_checked:
    errors.append('check_missing')

if errors:
    print('|'.join(errors))
else:
    print('ok')
" "$commit_msg_file" 2>/dev/null)

    if [ "$result" != "ok" ] && [ -n "$result" ]; then
        echo ""
        echo "$result" | grep -q "acceptance_missing" && {
            echo "❌ 提交信息中未检测到 [验收通过] 标记！"
            echo "   提交信息格式：<type>: <描述> [已检查] [验收通过]"
        }
        echo "$result" | grep -q "approval_missing" && {
            echo "❌ 检测到结构性变更，但提交信息中未检测到 [方案已确认] 标记！"
            echo "   结构性变更提交格式：<type>: <描述> [方案已确认] [已检查] [验收通过]"
        }
        echo "$result" | grep -q "check_missing" && {
            echo "❌ 提交信息中未检测到 [已检查] 标记！"
            echo "   提交前请完成「交付检查清单」并确认所有检查项"
            echo "   提交信息格式：<type>: <描述> [已检查] [验收通过]"
        }
        echo "   如需跳过（不推荐），使用 'git commit --no-verify'"
        exit 1
    fi
fi

exit 0
